generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model books {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo      String
  autor       String
  precio      Decimal       @db.Decimal(10, 2)
  stock       Int           @default(0)
  imagen_url  String?
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  order_items order_items[]
}

/// role/estado/precio/etc. are also constrained by CHECK constraints in the
/// database (see supabase/schema.sql) — Prisma doesn't enforce those client-side.
model order_items {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id        String  @db.Uuid
  book_id         String  @db.Uuid
  cantidad        Int
  precio_unitario Decimal @db.Decimal(10, 2)
  books           books   @relation(fields: [book_id], references: [id], onUpdate: NoAction)
  orders          orders  @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([book_id])
  @@index([order_id])
}

model orders {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String        @db.Uuid
  total       Decimal       @default(0) @db.Decimal(10, 2)
  estado      String        @default("pendiente")
  created_at  DateTime      @default(now()) @db.Timestamptz(6)
  order_items order_items[]
  profiles    profiles      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id])
}

/// id references Supabase's built-in auth.users.id (enforced at the database
/// level, see supabase/schema.sql). Not modeled as a Prisma relation here —
/// Supabase Auth manages that schema through its own API, not through Prisma.
model profiles {
  id               String   @id @db.Uuid
  nombre           String
  email            String
  role             String   @default("cliente")
  theme_preference String   @default("light")
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  orders           orders[]
}
